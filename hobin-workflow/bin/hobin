    "budget_usd_per_round": 5.0,
    # 티켓 하나의 누적 비용 상한 (재시도·후속 요청 포함). 넘으면 멈추고 사람에게 묻는다.
    "budget_usd_per_ticket": 15.0,
    # 선행 티켓이 어느 상태여야 후속 티켓을 시작하나: "merged"(검증·병합되면) 또는 "done"(사람이 accept한 뒤)
    "depends_require": "merged",
