    # 겹침 판정에서 빠진다. 충돌은 병합 단계에서 푼다.
    "shared_paths": [],
    # 충돌이 나면 손으로 풀지 않고 다시 만드는 파일: {"package-lock.json": "npm install --package-lock-only"}
    "regen_on_conflict": {},
