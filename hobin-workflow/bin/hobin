#!/usr/bin/env python3
"""hobin-workflow (hobin): Claude Code용 라우터-워커 티켓 실행기.

AI가 판단할 일(구현, 검증, 대화)은 Claude Code에 맡기고,
일이 굴러가게 하는 배관(상태 저장, 보고 전달, 작업 공간 분리,
동시 실행 제한, 범위 확인, 병합, 감시)은 이 코드가 맡는다.

표준 라이브러리만 사용한다. Python 3.9+, git 2.32+, POSIX(macOS/Linux).
"""
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import html
import json
import os
import re
import selectors
import shlex
import signal
import subprocess
import sys
import threading
import time
import uuid
from contextlib import contextmanager
from pathlib import Path

VERSION = "0.2.0"
PKG_DIR = Path(__file__).resolve().parent.parent
PROMPTS_DIR = PKG_DIR / "prompts"

# ---------------------------------------------------------------------------
# 상태 기계: 상태와 전이는 여기 한 곳에서만 정의한다.
# ---------------------------------------------------------------------------
STATUS_LABEL = {
    "draft": "작성 중",
    "ready": "대기",
    "running": "작업 중",
    "verifying": "검증 중",
    "merging": "병합 중",
    "needs_human": "사람 답변 필요",
    "failed": "실패",
    "merged": "검토 대기",
    "done": "완료",
    "dropped": "취소",
}
ACTIVE = {"running", "verifying", "merging"}
DEPS_SATISFIED = {"merged", "done"}
TRANSITIONS = {
    "draft": {"ready", "dropped"},
    "ready": {"running", "draft", "dropped"},
    "running": {"running", "verifying", "merging", "merged", "needs_human", "failed", "dropped"},  # merging: 사람 승인 후 바로 병합
    "verifying": {"running", "merging", "failed", "needs_human"},
    "merging": {"running", "merged", "failed", "needs_human"},
    "needs_human": {"ready", "dropped"},
    "failed": {"ready", "dropped"},
    "merged": {"done", "ready", "dropped"},  # dropped: 반려(reject --drop)
    "done": set(),
    "dropped": set(),
}
BOARD_COLUMNS = [
    ("대기", ["draft", "ready"]),
    ("진행 중", ["running", "verifying", "merging"]),
    ("사람 필요", ["needs_human", "failed"]),
    ("검토 대기", ["merged"]),
    ("완료", ["done", "dropped"]),
]

DEFAULT_CONFIG = {
    "base_branch": None,  # init 시 현재 브랜치로 채움
    "integration_branch": "hobin/integration",
    "branch_prefix": "hobin/",
    "max_workers": 3,
    "max_rounds": 3,
